{
  "formatVersion": 1,
  "scenarios": [
    {
      "id": "opencode-current-directory", "description": "Current OpenCode Skill directory.", "targetId": "opencode",
      "installation": { "state": "found", "command": "opencode" },
      "entries": [{ "type": "file", "path": ".config/opencode/skills/review/SKILL.md", "content": "---\nname: review\nversion: 1.0.0\n---\n# Review\n" }],
      "expected": { "configPath": ".config/opencode/opencode.jsonc", "observations": [{ "runtimeName": "review", "locationRole": "preferred-runtime", "availability": "enabled", "owner": "user" }] }
    },
    {
      "id": "opencode-legacy-singular-directory", "description": "Legacy singular OpenCode Skill directory.", "targetId": "opencode",
      "entries": [{ "type": "file", "path": ".config/opencode/skill/tools/review/SKILL.md", "content": "---\nname: legacy-review\nversion: 1.0.0\n---\n# Legacy review\n" }],
      "expected": { "configPath": ".config/opencode/opencode.jsonc", "observations": [{ "runtimeName": "legacy-review", "locationRole": "alternate-runtime", "availability": "enabled" }] }
    },
