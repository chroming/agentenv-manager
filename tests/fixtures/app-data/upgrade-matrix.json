{
  "formatVersion": 1,
  "scenarios": [
    {
      "id": "fresh-empty-data-root",
      "description": "A fresh install registers the current format without migration.",
      "entries": [],
      "expected": { "outcome": "success", "migrated": false, "profileCount": 0, "retainedProfileCount": 0, "manifestVersion": 2 }
    },
    {
      "id": "unversioned-settings-data",
      "description": "Unversioned application data is backed up and registered.",
      "entries": [{ "path": "settings.json", "content": "{\"language\":\"en\"}\n" }],
      "expected": { "outcome": "success", "migrated": true, "profileCount": 0, "retainedProfileCount": 0, "manifestVersion": 2, "preserved": [{ "path": "settings.json", "content": "{\"language\":\"en\"}\n" }] }
    },
    {
      "id": "v1-empty-data",
      "description": "An empty v1 root advances to v2.",
      "entries": [{ "path": "agentenv-data.json", "content": "{\"formatVersion\":1}\n" }],
      "expected": { "outcome": "success", "migrated": true, "profileCount": 0, "retainedProfileCount": 0, "manifestVersion": 2 }
    },
    {
      "id": "v1-opencode-profile",
      "description": "A complete v1 OpenCode Profile migrates to the portable v2 layout.",
      "entries": [
        { "path": "agentenv-data.json", "content": "{\"formatVersion\":1}\n" },
        { "path": "profiles/daily/profile.json", "content": "{\"id\":\"daily\",\"targetId\":\"opencode\",\"name\":\"Daily\",\"version\":1,\"managed\":{\"agents\":true,\"mcp\":true,\"skills\":true}}\n" },
        { "path": "profiles/daily/AGENTS.md", "content": "# Daily instructions\n" },
        { "path": "profiles/daily/assets.json", "content": "{\"ownedDirs\":[],\"mcpSelections\":[{\"targetId\":\"opencode\",\"name\":\"docs\",\"enabled\":true}]}\n" }
      ],
      "expected": { "outcome": "success", "migrated": true, "profileCount": 1, "retainedProfileCount": 0, "manifestVersion": 2, "preserved": [{ "path": "profiles/daily/INSTRUCTIONS.md", "content": "# Daily instructions\n" }], "absent": ["profiles/daily/AGENTS.md", "profiles/daily/assets.json"] }
    },
    {
      "id": "v1-current-profile",
      "description": "A valid v2 Profile inside a v1 root is retained unchanged.",
      "entries": [
        { "path": "agentenv-data.json", "content": "{\"formatVersion\":1}\n" },
        { "path": "profiles/current/profile.json", "content": "{\"id\":\"current\",\"name\":\"Current\",\"description\":\"\",\"version\":2}\n" },
        { "path": "profiles/current/INSTRUCTIONS.md", "content": "# Current\n" },
        { "path": "profiles/current/resources.json", "content": "{\"skills\":[],\"mcpByTarget\":{}}\n" }
      ],
      "expected": { "outcome": "success", "migrated": true, "profileCount": 0, "retainedProfileCount": 0, "manifestVersion": 2, "preserved": [{ "path": "profiles/current/INSTRUCTIONS.md", "content": "# Current\n" }] }
    },
    {
      "id": "v1-malformed-profile-retained",
      "description": "A malformed Profile is retained and reported instead of deleted.",
      "entries": [
        { "path": "agentenv-data.json", "content": "{\"formatVersion\":1}\n" },
        { "path": "profiles/broken/profile.json", "content": "{\"id\":\"broken\",\"name\":\"Broken\",\"version\":2}\n" },
        { "path": "profiles/broken/INSTRUCTIONS.md", "content": "# Keep me\n" }
      ],
      "expected": { "outcome": "success", "migrated": true, "profileCount": 0, "retainedProfileCount": 1, "manifestVersion": 2, "preserved": [{ "path": "profiles/broken/INSTRUCTIONS.md", "content": "# Keep me\n" }], "reportContains": "broken" }
    },
    {
      "id": "v1-malformed-target-state-retained",
      "description": "Malformed Target state remains available for recovery.",
      "entries": [
        { "path": "agentenv-data.json", "content": "{\"formatVersion\":1}\n" },
        { "path": "target-states/opencode.json", "content": "not json\n" }
      ],
      "expected": { "outcome": "success", "migrated": true, "profileCount": 0, "retainedProfileCount": 0, "manifestVersion": 2, "preserved": [{ "path": "target-states/opencode.json", "content": "not json\n" }], "reportContains": "opencode.json" }
    },
    {
      "id": "v1-target-state-upgrade",
      "description": "A valid legacy Target state advances to the current Target state format.",
      "entries": [
        { "path": "agentenv-data.json", "content": "{\"formatVersion\":1}\n" },
        { "path": "target-states/codex.json", "content": "{\"formatVersion\":1,\"managedMcpNames\":[\"docs\"],\"managedResources\":[{\"kind\":\"instructions\",\"id\":\"AGENTS.md\",\"path\":\"/tmp/AGENTS.md\",\"contentHash\":\"abc\"}]}\n" }
      ],
      "expected": { "outcome": "success", "migrated": true, "profileCount": 0, "retainedProfileCount": 0, "manifestVersion": 2, "jsonMatches": [{ "path": "target-states/codex.json", "value": { "formatVersion": 3, "managedMcpNames": ["docs"] } }] }
    },
    {
      "id": "v1-production-shaped-workspace",
      "description": "A production-shaped root migrates legacy Profiles and Target state while preserving current Profiles, Library metadata, settings, source records, and unrelated recovery data.",
      "entries": [
        { "path": "agentenv-data.json", "content": "{\"formatVersion\":1}\n" },
        { "path": "settings.json", "content": "{\"locale\":\"zh_CN\",\"skillSyncMethod\":\"copy\",\"enabledTargetIds\":[\"codex\",\"opencode\"],\"telemetryEnabled\":false}\n" },
        { "path": "skill-sources.json", "content": "{\"formatVersion\":2,\"sources\":[]}\n" },
        { "path": "profiles/daily/profile.json", "content": "{\"id\":\"daily\",\"targetId\":\"codex\",\"name\":\"Daily Coding\",\"description\":\"Legacy working profile\",\"version\":1,\"managed\":{\"agents\":true,\"mcp\":true,\"skills\":true}}\n" },
        { "path": "profiles/daily/AGENTS.md", "content": "# Daily instructions\n" },
        { "path": "profiles/daily/assets.json", "content": "{\"ownedDirs\":[{\"kind\":\"skill\",\"source\":\"skills/reviewer\",\"targetName\":\"reviewer\"}],\"mcpSelections\":[{\"targetId\":\"codex\",\"name\":\"docs\",\"enabled\":true}]}\n" },
        { "path": "profiles/daily/skills/reviewer/SKILL.md", "content": "---\nname: reviewer\ndescription: Review changes safely.\n---\n# Reviewer\n" },
        { "path": "profiles/current/profile.json", "content": "{\"id\":\"current\",\"name\":\"Current Review\",\"description\":\"Already current\",\"version\":2}\n" },
        { "path": "profiles/current/INSTRUCTIONS.md", "content": "# Current review\n" },
        { "path": "profiles/current/resources.json", "content": "{\"skills\":[],\"managementByTarget\":{},\"mcpByTarget\":{}}\n" },
        { "path": "skills-library/existing/SKILL.md", "content": "---\nname: existing\ndescription: Existing Library Skill.\n---\n# Existing\n" },
        { "path": "skills-library/existing/.agentenv-skill.json", "content": "{\"sourceType\":\"local\",\"updatePolicy\":\"untracked\"}\n" },
        { "path": "target-states/codex.json", "content": "{\"formatVersion\":1,\"managedMcpNames\":[\"docs\"],\"activeProfileId\":\"daily\",\"managedResources\":[{\"kind\":\"instructions\",\"id\":\"AGENTS.md\",\"path\":\"/tmp/home/.codex/AGENTS.md\",\"contentHash\":\"instructions-hash\"},{\"kind\":\"skill\",\"id\":\"reviewer\",\"path\":\"/tmp/home/.codex/skills/reviewer\",\"contentHash\":\"skill-hash\"}]}\n" },
        { "path": "backups/user-note.txt", "content": "preserve unrelated recovery data\n" }
      ],
      "expected": {
        "outcome": "success",
        "migrated": true,
        "profileCount": 1,
        "retainedProfileCount": 0,
        "manifestVersion": 2,
        "preserved": [
          { "path": "settings.json", "content": "{\"locale\":\"zh_CN\",\"skillSyncMethod\":\"copy\",\"enabledTargetIds\":[\"codex\",\"opencode\"],\"telemetryEnabled\":false}\n" },
          { "path": "skill-sources.json", "content": "{\"formatVersion\":2,\"sources\":[]}\n" },
          { "path": "profiles/current/INSTRUCTIONS.md", "content": "# Current review\n" },
          { "path": "skills-library/existing/SKILL.md", "content": "---\nname: existing\ndescription: Existing Library Skill.\n---\n# Existing\n" },
          { "path": "skills-library/reviewer/SKILL.md", "content": "---\nname: reviewer\ndescription: Review changes safely.\n---\n# Reviewer\n" },
          { "path": "backups/user-note.txt", "content": "preserve unrelated recovery data\n" }
        ],
        "absent": ["profiles/daily/AGENTS.md", "profiles/daily/assets.json", "profiles/daily/skills"],
        "jsonMatches": [
          { "path": "profiles/daily/profile.json", "value": { "id": "daily", "preferredTargetId": "codex", "createdFromTargetId": "codex", "version": 2 } },
          { "path": "target-states/codex.json", "value": { "formatVersion": 3, "activeProfileId": "daily", "managedMcpNames": ["docs"] } }
        ]
      }
    },
    {
      "id": "v1-unsafe-profile-rolls-back",
      "description": "An unsafe legacy asset path restores the complete original root.",
      "entries": [
        { "path": "agentenv-data.json", "content": "{\"formatVersion\":1}\n" },
        { "path": "profiles/unsafe/profile.json", "content": "{\"id\":\"unsafe\",\"targetId\":\"codex\",\"name\":\"Unsafe\",\"version\":1,\"managed\":{\"instructions\":true,\"config\":true,\"assets\":true}}\n" },
        { "path": "profiles/unsafe/assets.json", "content": "{\"ownedDirs\":[{\"kind\":\"skill\",\"source\":\"../outside\",\"targetName\":\"unsafe\"}]}\n" }
      ],
      "expected": { "outcome": "failure", "errorIncludes": "original data was restored", "exactOriginalTree": true }
    },
    {
      "id": "future-data-format-rejected",
      "description": "A newer data format is never downgraded.",
      "entries": [{ "path": "agentenv-data.json", "content": "{\"formatVersion\":99}\n" }],
      "expected": { "outcome": "failure", "errorIncludes": "Unsupported AgentEnv data format", "exactOriginalTree": true }
    }
  ]
}
